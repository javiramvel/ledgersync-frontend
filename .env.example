# Copy to .env.local and fill in. Never commit real values.

# Stellar network the dashboard executes on: testnet | mainnet
# Contract IDs are read from deployments/<network>.json (written by scripts/deploy.sh).
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional RPC override (defaults: soroban-testnet.stellar.org / mainnet.sorobanrpc.com)
# NEXT_PUBLIC_SOROBAN_RPC_URL=

# Server-only reference quotes for the Chainlink price-parity check (finnhub.io)
FINNHUB_API_KEY=

# Plaid custodian bridge (sandbox | production)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# 32-byte hex key that encrypts the Plaid access token cookie: openssl rand -hex 32
PLAID_TOKEN_SECRET=

# SEC 17a-4 WORM audit log: S3 bucket with Object Lock enabled
AUDIT_BUCKET=
AUDIT_RETENTION_YEARS=6
AWS_REGION=us-east-1
# Local development only; on ECS the task role provides credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
